# ==============================================================================
# FieldService Environment Configuration Template
# Copy this file to '.env' and populate your local secrets.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Database Configuration
POSTGRES_DB=fieldservice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Spring Datasource Bindings (Used by Backend)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fieldservice
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Spring Profile ('dev' for local development, 'prod' for production deployment)
SPRING_PROFILES_ACTIVE=dev

# Application JWT Security
# In 'prod' profile, this must be set and MUST be at least 32 bytes (256 bits) long.
# Generate a secure key using: openssl rand -hex 32
APP_JWT_SECRET=9a3f2c4e6b8a1d5e7f0b2d4c6e8a1f3b5c7d9e1a3b5c7d9e1a3b5c7d9e1a3b5c
APP_JWT_EXPIRATION_MS=86400000
